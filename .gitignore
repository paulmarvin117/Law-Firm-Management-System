# ==============================
# SECRETS AND ENVIRONMENT FILES
# ==============================
.env
.env.*
!.env.example

# Frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# Backend environment files
backend/.env
backend/.env.*
!backend/.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ==============================
# PYTHON / FASTAPI
# ==============================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ==============================
# NEXT.JS / NODE.JS
# ==============================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/coverage/

# ==============================
# LOGS
# ==============================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# DATABASES AND BACKUPS
# ==============================
*.db
*.sqlite
*.sqlite3
*.bak
backups/

# ==============================
# EDITORS AND OPERATING SYSTEM
# ==============================
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# ==============================
# CLIENT DATA (never commit real client data)
# ==============================
backend/uploads/
backend/storage/
*.dump
*.sql
